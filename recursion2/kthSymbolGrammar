#include<iostream>
#include<string>
#include<vector>
using namespace std;
int kthGrammar(int n, int k) {
        if(n==1) return 0;
        if(k%2==0){
            int preAns= kthGrammar(n-1,k/2);
            if(preAns==0) return 1;
            else return 0;
        }
        else{
            int preAns= kthGrammar(n-1,k/2+1);
            return preAns;
        }
    }
int main(){
    int n=3;
    int k=7;
    kthGrammar(n,k);

}
